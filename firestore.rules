rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // تسمح للقراءة والكتابة للمستخدمين المسجلين فقط بشكل مبدئي
    // سنقوم بتدقيقها لاحقاً حسب الأدوار (admin, teacher, student)
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
    
    // قواعد خاصة ببيانات المستخدمين
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.uid == userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }
  }
}
